# Nicht-geheime Konfiguration. ECHTE Geheimnisse gehoeren NICHT hierher
# (siehe secrets.example.json -> secrets.json, chmod 600).
HILO_TIMEZONE=Europe/Berlin
HILO_RUN_HOUR=7
HILO_DATA_DIR=./data
HILO_LOG_DIR=./logs
# Bild-Erzeugung (#137): das Bild-TOOL (OpenAI/Ideogram) wird in der Verwaltung umgeschaltet
# (Einstellung 'bild_tool'); Ideogram braucht 'ideogram_api_key' in den Secrets. Optionale
# Feinjustierung der Anbieter-Parameter ohne Code-Aenderung:
# HILO_OPENAI_IMAGE_MODEL=gpt-image-2          # OpenAI-Bildmodell (Default gpt-image-2)
# HILO_IMAGE_QUALITY=medium                    # low|medium|high|auto (OpenAI-Kosten)
# HILO_IDEOGRAM_RESOLUTION=1024x1024           # Ideogram-Format (Default quadratisch)
# HILO_IDEOGRAM_RENDERING_SPEED=DEFAULT        # Ideogram rendering_speed
# Themen-Radar-Quellen: HILO-eigene Steuertipps sind bereits standardmaessig aktiv
# (https://www.hilo.de/steuertipps/feed/). Optional weitere Feeds eintragen:
HILO_SOURCES_BMF=
HILO_SOURCES_HAUFE=
# HILO_SOURCES_HILO=https://www.hilo.de/steuertipps/feed/
